# TraveNest web environment. Copy to apps/web/.env.local.
# Only NEXT_PUBLIC_* values belong here: they are bundled into the browser,
# so never put API secrets (database, JWT, PayHere, SMTP, service keys) in this file.

# Base URL of the API, including /api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Public URL of this web app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (public bucket only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
