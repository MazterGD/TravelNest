# TraveNest API environment. Copy to apps/api/.env (or the repo-root .env)
# and fill in real values. Never commit real secrets.
# Values marked (required in production) stop the API from starting if unset
# when NODE_ENV=production.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_VERSION=v1
# Trip-day checks use server-local dates; run the API in Sri Lanka time.
TZ=Asia/Colombo
# Public URL of the web app (used for links in emails and OAuth redirects) (required in production)
APP_URL=http://localhost:3000
# Public base URL of this API, including /api/v1
API_BASE_URL=http://localhost:5000/api/v1
# Allowed browser origin for CORS and Socket.IO (required in production)
CORS_ORIGIN=http://localhost:3000
# Express "trust proxy": leave empty when reached directly, 1 behind Caddy
TRUST_PROXY=
# Cookie domain for refresh/CSRF cookies when web and API are sibling
# subdomains, e.g. .travenest.example (leave empty for localhost)
COOKIE_DOMAIN=

# --- Database ------------------------------------------------------------------
# PostgreSQL 16 with PostGIS. Apply schema with: pnpm db:migrate:deploy
DATABASE_URL=postgresql://user:password@localhost:5432/travenest

# --- Auth ----------------------------------------------------------------------
# Long random strings (openssl rand -hex 32) (required in production)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=30d
# Optional; derived from JWT_SECRET when empty
OAUTH_STATE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/oauth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:5000/api/v1/auth/oauth/facebook/callback

# --- Encryption ----------------------------------------------------------------
# Encrypts owner bank account details at rest (required in production)
SETTLEMENT_BANK_ENCRYPTION_KEY=

# --- PayHere -------------------------------------------------------------------
# Merchant credentials (required in production)
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Merchant API app (refunds)
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
# sandbox | live
PAYHERE_MODE=sandbox
# Must be a public HTTPS URL for PayHere to reach the webhook
PAYHERE_NOTIFY_URL=https://api.example.com/api/v1/payments/webhook
PAYHERE_RETURN_URL=http://localhost:3000/en/dashboard/bookings
PAYHERE_CANCEL_URL=http://localhost:3000/en/dashboard/bookings

# --- Bank transfer details shown to customers ----------------------------------
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=
BANK_REFERENCE_HINT=Use your booking reference as the payment note.

# --- Email (Brevo SMTP relay) ---------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# --- Storage (Supabase) ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# Public bucket: vehicle photos, avatars
SUPABASE_BUCKET=travenest
# Private bucket: owner/vehicle documents, payment receipts (ADR-001)
SUPABASE_PRIVATE_BUCKET=travenest-private
# Server-only key for the private bucket; never expose to the browser (required in production)
SUPABASE_SERVICE_ROLE_KEY=
MAX_FILE_SIZE=5242880

# --- Rate limiting (enforced in production only) --------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# --- Routing --------------------------------------------------------------------
OSRM_BASE_URL=http://127.0.0.1:5001
OSRM_TIMEOUT_MS=15000
